# openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
KEYCLOAK_ISSUER=http://localhost:24080/realms/myapp
KEYCLOAK_CLIENT_ID=myapp-web
# Public client needs no secret. Enable below for a confidential client.
# KEYCLOAK_CLIENT_SECRET=
# Next.js dev server: `next dev -p 24030`
NEXTAUTH_URL=http://localhost:24030
# NestJS API base URL, called server-side
BACKEND_API_URL=http://localhost:24041
