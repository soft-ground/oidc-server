# openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
HYDRA_ISSUER=http://localhost:4444
HYDRA_CLIENT_ID=hydra-web
# Public client: no secret at the token endpoint (PKCE only).
# HYDRA_CLIENT_SECRET=
# Next.js dev server: `next dev -p 24031`
NEXTAUTH_URL=http://localhost:24031
# NestJS API base URL, called server-side
BACKEND_API_URL=http://localhost:24042
